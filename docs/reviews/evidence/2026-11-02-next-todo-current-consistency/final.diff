+  const seen = new Set<string>();
+  const add = (todo: Todo, owner: string | null, pinIndex: number | null) => {
+    if (todo.status !== "open" || seen.has(todo.uid)) return;
+    seen.add(todo.uid);
+    items.push({
+      kind: "todo",
+      uid: todo.uid,
+      title: todo.title,
+      project: owner,
+      pinned: pinIndex !== null,
+      pinIndex,
+      createdAt: todo.createdAt,
+      entryUid: todo.entryUid,
+    });
+  };
+  for (const name of projects) {
+    const entry = latest.find((entry) => entry.project === name);
+    if (entry?.nextTodoUids !== undefined) {
+      entry.nextTodoUids.forEach((uid, index) => {
+        const todo = todoByUid(db, uid);
+        if (todo) add(todo, name, index);
+      });
+    } else if (entry) {
+      const source = legacySource(db, entry);
+      source.nextSteps.forEach((title, index) => {
+        const todo = stepTodo(db, source.uid, index);
+        if (todo) add(todo, name, index);
+        else
+          items.push({
+            kind: "legacy-step",
+            project: name,
+            entryUid: source.uid,
+            stepIndex: index,
+            title,
+            pinned: true,
+            pinIndex: index,
+          });
+      });
+    }
+    for (const todo of todos) if (todo.project === name) add(todo, name, null);
+  }
+  if (project === undefined)
+    for (const todo of todos) if (todo.project === null) add(todo, null, null);
+  return items;
