# Optional SQLite database override. When unset, the database is stored at
# ~/.local/share/project-mgr/project-mgr.sqlite.
# Use a literal absolute path here; .env files do not expand ~ or $HOME.
# PMGR_DB_PATH=/absolute/path/to/project-mgr.sqlite

# For isolated manual testing, use a separate database instead:
# PMGR_DB_PATH=/tmp/project-mgr-manual-test.sqlite

# Local Web server port.
PORT=3000
