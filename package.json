{
  "name": "project-mgr",
  "version": "0.1.2",
  "description": "Local-first append-only project status ledger",
  "type": "module",
  "bin": {
    "pmgr": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "pmgr": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "tsx --test test/**/*.test.ts",
    "coverage": "c8 --all --extension .ts --exclude 'dist/**' --exclude 'test/**' --check-coverage --statements 100 --branches 100 --functions 100 --lines 100 pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "c8": "^10.1.3",
    "eslint": "^9.30.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2"
}
